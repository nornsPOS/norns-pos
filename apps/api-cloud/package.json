{
  "name": "@norns/api-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Warehouse14 Cloud API — Fastify + TypeBox + better-auth + mTLS + pg_notify SSE",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/kopiere-fiskaldateien.mjs",
    "dev:bootstrap": "tsx --env-file-if-exists=../../.env scripts/dev-bootstrap.ts",
    "dev:seed": "tsx --env-file-if-exists=../../.env scripts/seed-test-data.ts",
    "dev": "pnpm run dev:bootstrap && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run --passWithNoTests --exclude '**/tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .tsbuildinfo coverage",
    "test:tief": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/sensible": "5.6.0",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "4.2.0",
    "@sentry/node": "^8.0.0",
    "@sinclair/typebox": "0.32.35",
    "@norns/appointments": "workspace:*",
    "@norns/audit": "workspace:*",
    "@norns/auth-pin": "workspace:*",
    "@norns/db": "workspace:*",
    "@norns/domain": "workspace:*",
    "@norns/email": "workspace:*",
    "@norns/inventory-lock": "workspace:*",
    "better-auth": "1.3.34",
    "close-with-grace": "1.3.0",
    "csv-stringify": "6",
    "drizzle-orm": "0.36.4",
    "embedded-postgres": "17.10.0-beta.17",
    "fastify": "4.28.1",
    "fastify-metrics": "11.0.0",
    "fastify-plugin": "4.5.1",
    "pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "postgres": "3.4.5",
    "satori": "^0.26.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.13.2",
    "@types/node": "20.17.10",
    "@types/node-forge": "1.3.14",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "2.1.8",
    "@norns/config": "workspace:*",
    "node-forge": "1.4.0",
    "testcontainers": "10.13.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
